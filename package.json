{
    "name": "tramore-last-man-standing",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "sim": "node --import tsx sim/cli.ts",
        "feed:check": "node --import tsx scripts/check-feeds.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "node --import tsx scripts/migrate.ts",
        "db:studio": "drizzle-kit studio",
        "db:seed": "node --import tsx scripts/seed.ts",
        "tick": "node --import tsx scripts/tick.ts",
        "dev:add-player": "node --import tsx scripts/add-player.ts"
    },
    "dependencies": {
        "drizzle-orm": "^0.45.4",
        "next": "^16.4.3",
        "nodemailer": "^10.3.1",
        "postgres": "^4.0.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "yaml": "^2.9.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@next/eslint-plugin-next": "^16.4.3",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^26.6.6",
        "@types/nodemailer": "^8.0.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "drizzle-kit": "^0.31.11",
        "eslint": "^10.14.0",
        "postcss": "^8.5.32",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.0.5"
    }
}
