# Copy to .env.local and fill in. .env.local is ignored by Git.

# football-data.org API token (primary feed)
FOOTBALL_DATA_TOKEN=

# Postgres. Local: Homebrew postgresql@16. Vercel: injected by the Neon integration.
POSTGRES_URL=postgres://localhost:5432/lastmanstanding

# Stripe (test keys while building)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email. console prints emails in the dev server terminal. gmail sends them.
EMAIL_TRANSPORT=console
# For EMAIL_TRANSPORT=gmail: the club Gmail and an app password
# (Google Account → Security → 2-Step Verification → App passwords).
GMAIL_USER=tramoreathleticsecretary@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_REPLY_TO=tramoreathleticsecretary@gmail.com

# Comma-separated admin emails
ADMIN_EMAILS=

# Shared secret for cron-job.org and Vercel Cron calling /api/cron/tick.
# At least 32 characters. Generate one with: openssl rand -hex 32
CRON_SECRET=

# Public site URL, used in emails and WhatsApp messages
SITE_URL=http://localhost:3000
